# compute_cap.rs sm_87 兼容性修复
#
# 问题：candle 的 compute_cap_matching(87, 87) 返回 false
# 根因：match 分支缺少 sm_87（Orin Ampere）的兼容映射
# 影响：TEI 在 Jetson Orin 上启动报 "Runtime compute cap 87 is not compatible with compile time compute cap 87"
#
# 原始代码：
#   (80..=89, 80) => true,
#   (86..=89, 80..=86) => true,
#
# compile=87 时，(87, 87) 不匹配任何分支 → 落入 (_, _) => false
#
# 修复：合并为 (80..=89, 80..=89) => true（Ampere 系列内部全兼容）
# sm_87 GPU 完全兼容 sm_80 编译的代码（同代 Ampere 架构）
#
# 上游 issue：https://github.com/huggingface/text-embeddings-inference/issues/467
# 适用版本：candle rev 6381023982251959a2c9bab7378b3013304e192b（TEI 1.9.3）
#
# 用法（在本仓库根目录执行，TEI 源码位于 tei-src/）：
#   patch -d tei-src -p1 < patches/compute_cap-sm87-fix.patch
# 或在 TEI 源码根目录执行：
#   patch -p1 < /path/to/TEI-on-Jetson/patches/compute_cap-sm87-fix.patch
# 或手动 sed（NX 上实际使用的方式）：
#   sed -i 's|(80..=89, 80) => true,|(80..=89, 80..=89) => true,|' backends/candle/src/compute_cap.rs
#   sed -i '/(86..=89, 80..=86) => true,/d' backends/candle/src/compute_cap.rs
#   sed -i '/(89, 89) => true,/d' backends/candle/src/compute_cap.rs

--- a/backends/candle/src/compute_cap.rs
+++ b/backends/candle/src/compute_cap.rs
@@ -28,8 +28,6 @@
 fn compute_cap_matching(runtime_compute_cap: usize, compile_compute_cap: usize) -> bool {
     match (runtime_compute_cap, compile_compute_cap) {
         (75, 75) => true,
-        (80..=89, 80) => true,
-        (86..=89, 80..=86) => true,
+        (80..=89, 80..=89) => true, // Ampere 系列内部兼容（修复 sm_87 Jetson Orin）
-        (89, 89) => true,
         (90, 90) => true,
         (100, 100) => true,
